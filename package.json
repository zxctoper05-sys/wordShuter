{
  "name": "word-shooter",
  "version": "1.0.0",
  "description": "Typing shooter: falling words, Canvas, Node.js + Express + PostgreSQL",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node db/migrate.js",
    "dict:download": "node scripts/download-dictionaries.js",
    "dict:import": "node scripts/import-dictionary.js",
    "setup": "npm run migrate && npm run dict:download && npm run dict:import",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "strip-comments": "^2.0.1"
  }
}
